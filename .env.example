# Homys Frontend — Environment Variables
# Copy this file to .env and fill in the values.

# Base URL for the backend API (no trailing slash).
# In development the Vite proxy rewrites /api → VITE_BACKEND_URL/api,
# so you usually only need VITE_BACKEND_URL locally.
# In production (Netlify / Vercel) set VITE_API_URL to the full backend URL.
VITE_API_URL=

# Dev-only: backend origin for the Vite proxy (no path, no trailing slash).
VITE_BACKEND_URL=http://localhost:5000
